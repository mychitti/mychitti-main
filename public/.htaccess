<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value memory_limit 256M
    php_value max_execution_time 120
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
      # Redirect www to non-www
      RewriteCond %{HTTP_HOST} ^www\.mychitti\.net [NC]
      RewriteRule ^(.*)$ https://mychitti.net/$1 [L,R=301]
     

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve public storage assets directly (bypass Laravel) on vendor/admin domains.
    # Vendor custom domains (firozdental.com etc) render the full storefront from this same
    # docroot, so every public media directory the front-end references must be listed here —
    # anything missing falls through to the rule below and is answered with the storefront HTML
    # instead of the image. Private media (documents, invoice, quotations, employee, admin,
    # patient, order, refund, purchase-order, gatepass, service_report, task, project, temp)
    # is deliberately absent so it keeps going through Laravel's auth check.
    RewriteCond %{HTTP_HOST} !^(www\.)?mychitti\.net$ [NC]
    RewriteCond %{REQUEST_URI} ^/storage/(store|profile|business|business_image|uploaded|vendor_login|product|product-variations|category|banner|banners|promotional_banner|header_banner|header_icon|campaign|module|restaurant|blog|blog_content_images|review|reviewer_image|reviewer_company_image|school|inventory|inventory-item|inventory-variations|nav|util|preview)/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all other /storage/ through Laravel on admin/vendor (auth check)
    RewriteCond %{HTTP_HOST} !^(www\.)?mychitti\.net$ [NC]
    RewriteRule ^storage/ index.php [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
    
    # cors
    Header set Access-Control-Allow-Origin "*"
</IfModule>
