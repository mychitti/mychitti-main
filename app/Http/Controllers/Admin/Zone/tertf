<?php

function getBoundingBoxCoordinates($address, $apiKey) {
    // URL encode the address
    $encodedAddress = urlencode($address);

    // Google Maps Geocoding API URL
    $url = "https://maps.googleapis.com/maps/api/geocode/json?address={$encodedAddress}&key={$apiKey}";

    // Initialize cURL
    $ch = curl_init();

    // Set the cURL options
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);

    // Execute the cURL request
    $response = curl_exec($ch);

    // Close cURL session
    curl_close($ch);

    // Decode the JSON response
    $responseData = json_decode($response, true);

    // Check if the response is valid
    if ($responseData['status'] === 'OK') {
        // Get the bounds from the response
        $northeast = $responseData['results'][0]['geometry']['bounds']['northeast'];
        $southwest = $responseData['results'][0]['geometry']['bounds']['southwest'];

        // Calculate the northwest and southeast coordinates
        $northwest = [
            'lat' => $northeast['lat'],
            'lng' => $southwest['lng']
        ];
        $southeast = [
            'lat' => $southwest['lat'],
            'lng' => $northeast['lng']
        ];

        // Format and return the bounds as a string with the required output format
        $coordinates = "({$northeast['lat']}, {$northeast['lng']}),"
                     . "({$northwest['lat']}, {$northwest['lng']}),"
                     . "({$southwest['lat']}, {$southwest['lng']}),"
                     . "({$southeast['lat']}, {$southeast['lng']}),"
                     . "({$northeast['lat']}, {$northeast['lng']})";

        return $coordinates;
    } else {
        return "Coordinates not found.";
    }
}

// Your Google Maps API key
$apiKey = 'YOUR_GOOGLE_MAPS_API_KEY';

// Address to get bounds for
$address = '110094, Delhi - Meerut Expy, Pocket D, Block E, Indirapuram, New Delhi, Delhi, 110091, India';

// Get bounding box coordinates
$coordinates = getBoundingBoxCoordinates($address, $apiKey);

// Output coordinates
echo $coordinates;

?>
