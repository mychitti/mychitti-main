        @push('script_2')
        
        <script>
            $("#att_form").on('submit', function(e){
                e.preventDefault();
                  var filteredElements =$(".att_status");
                  var daysArr = [];
                  var statusArr = [];
                  var month = $('.month_inp').val();
                  var year = $('.year_inp').val();
                  var emp_id = $('.emp_id').val();
    
                    filteredElements.each(function() {
                        if($(this).val() != 'P'){
                            statusArr.push($(this).val());
                            daysArr.push($(this).attr('data-id'));
                        }
                    });
                    
                  $.ajaxSetup({
                    headers: {
                        'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                    }
                 });
                $.post({
                    url: '{{route('vendor.leave-save')}}',
                    data: {
                        statusArr : statusArr,
                        daysArr: daysArr, 
                        year: year,
                        month: month,
                        emp_id : emp_id
                    },
                    success: function (data) {
                    //   console.log(data)
                    //   var datat = JSON.parse(data)
                    //   console.log(data['status']);
                    //   if(data.status){
                           window.location.reload();
                    //   }
                    },
                });
            })
        </script>
        @endpush