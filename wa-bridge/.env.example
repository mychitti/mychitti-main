# Where the bridge posts messages. Must be reachable from the box running this process.
INGEST_URL=https://admin.mychitti.net/whatsapp/bridge/ingest
# Must equal WA_BRIDGE_SECRET in the Laravel .env. Generate: openssl rand -hex 32
INGEST_SECRET=

# Session + retry spool. Keep OUTSIDE the repo: deploys run `git reset --hard`.
AUTH_DIR=/var/lib/wa-bridge/auth
SPOOL_DIR=/var/lib/wa-bridge/spool

# What to archive:
#   all    = every conversation this account can see (groups + one-to-one)
#   groups = groups only
#   list   = only the groups in GROUP_NAMES / GROUP_JIDS
CAPTURE=all

# Chats never to forward, whatever the mode. Bare numbers are accepted (country code, no +).
# Use this for family and anything else personal.
EXCLUDE_JIDS=

# Only used when CAPTURE=list. Names are matched case-insensitively on the group subject.
GROUP_NAMES=mychitti development
# Preferred once known (survives a group rename). Run `npm run groups` to list them.
GROUP_JIDS=

# Pull whatever backlog the phone will share on first pair. Turn off after the first run.
SYNC_HISTORY=0

BATCH_SIZE=40
FLUSH_MS=3000
LOG_LEVEL=info
